<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorBackgroundMain">#0D1117</Color>
    <Color x:Key="ColorBackgroundSurface">#161B22</Color>
    <Color x:Key="ColorBackgroundElevated">#21262D</Color>
    <Color x:Key="ColorBackgroundHover">#30363D</Color>

    <Color x:Key="ColorBorderSubtle">#30363D</Color>
    <Color x:Key="ColorBorderFocus">#58A6FF</Color>

    <Color x:Key="ColorAccentPrimary">#58A6FF</Color>
    <Color x:Key="ColorAccentPrimaryHover">#79B8FF</Color>
    <Color x:Key="ColorAccentRecording">#F85149</Color>
    <Color x:Key="ColorAccentTranscribing">#E3B341</Color>
    <Color x:Key="ColorAccentInjecting">#3FB950</Color>

    <Color x:Key="ColorTextPrimary">#F0F6FC</Color>
    <Color x:Key="ColorTextMuted">#8B949E</Color>
    <Color x:Key="ColorTextDim">#6E7681</Color>

    <SolidColorBrush x:Key="BrushBackgroundMain" Color="{StaticResource ColorBackgroundMain}" />
    <SolidColorBrush x:Key="BrushBackgroundSurface" Color="{StaticResource ColorBackgroundSurface}" />
    <SolidColorBrush x:Key="BrushBackgroundElevated" Color="{StaticResource ColorBackgroundElevated}" />
    <SolidColorBrush x:Key="BrushBackgroundHover" Color="{StaticResource ColorBackgroundHover}" />

    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderFocus" Color="{StaticResource ColorBorderFocus}" />

    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentPrimaryHover" Color="{StaticResource ColorAccentPrimaryHover}" />
    <SolidColorBrush x:Key="BrushAccentRecording" Color="{StaticResource ColorAccentRecording}" />
    <SolidColorBrush x:Key="BrushAccentTranscribing" Color="{StaticResource ColorAccentTranscribing}" />
    <SolidColorBrush x:Key="BrushAccentInjecting" Color="{StaticResource ColorAccentInjecting}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource ColorTextDim}" />

</ResourceDictionary>
