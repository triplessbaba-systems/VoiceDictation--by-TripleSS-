<Window x:Class="VoiceDictation.App.Views.CapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:VoiceDictation.App.ViewModels"
        mc:Ignorable="d"
        Title="VoiceDictation Capsule"
        Height="64"
        Width="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="CapsuleBorder"
            Background="{StaticResource BrushBackgroundSurface}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="30"
            Padding="16,8"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="18"
                              ShadowDepth="2"
                              Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="28" Height="28" Margin="0,0,10,0">
                <Ellipse Fill="{Binding StatusBrush}" Opacity="0.15" />
                <Path Data="{StaticResource IconMicrophone}"
                      Fill="{Binding StatusBrush}"
                      Width="14"
                      Height="14"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="8,0,12,0">
                <Border Width="3.5"
                        Height="{Binding BarHeight1}"
                        Background="{Binding StatusBrush}"
                        CornerRadius="1.75"
                        Margin="1.5,0" />
                <Border Width="3.5"
                        Height="{Binding BarHeight2}"
                        Background="{Binding StatusBrush}"
                        CornerRadius="1.75"
                        Margin="1.5,0" />
                <Border Width="3.5"
                        Height="{Binding BarHeight3}"
                        Background="{Binding StatusBrush}"
                        CornerRadius="1.75"
                        Margin="1.5,0" />
                <Border Width="3.5"
                        Height="{Binding BarHeight4}"
                        Background="{Binding StatusBrush}"
                        CornerRadius="1.75"
                        Margin="1.5,0" />
                <Border Width="3.5"
                        Height="{Binding BarHeight5}"
                        Background="{Binding StatusBrush}"
                        CornerRadius="1.75"
                        Margin="1.5,0" />
            </StackPanel>

            <Button Grid.Column="3"
                    Style="{StaticResource ButtonGhost}"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="Ayarlar"
                    Width="32"
                    Height="32"
                    Padding="6">
                <Path Data="{StaticResource IconGear}"
                      Stroke="{StaticResource BrushTextMuted}"
                      StrokeThickness="1.8"
                      Width="15"
                      Height="15"
                      Stretch="Uniform" />
            </Button>
        </Grid>
    </Border>
</Window>
