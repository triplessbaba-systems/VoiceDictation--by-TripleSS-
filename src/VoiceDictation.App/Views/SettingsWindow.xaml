<Window x:Class="VoiceDictation.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:VoiceDictation.App.ViewModels"
        mc:Ignorable="d"
        Title="Dikte Ayarları"
        Height="540"
        Width="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BrushBackgroundMain}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BrushBackgroundSurface}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    MouseDown="OnTitleBarMouseDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="{StaticResource IconGear}"
                          Stroke="{StaticResource BrushAccentPrimary}"
                          StrokeThickness="1.8"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0" />

                    <TextBlock Grid.Column="1"
                               Text="Dikte ve Model Yapılandırması"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding CancelCommand}"
                            Width="30"
                            Height="30"
                            Padding="6">
                        <Path Data="{StaticResource IconClose}"
                              Stroke="{StaticResource BrushTextMuted}"
                              StrokeThickness="2"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,16">
                <StackPanel>
                    <TextBlock Text="Kısayol ve Tetikleme"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Kısayol Tuşu"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontWeight="Medium"
                                       FontSize="13" />
                            <TextBlock Text="Dinlemeyi başlatan global tuş"
                                       Foreground="{StaticResource BrushTextDim}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableShortcutKeys}"
                                  SelectedItem="{Binding SelectedShortcutKey, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Tetikleme Yöntemi"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontWeight="Medium"
                                       FontSize="13" />
                            <TextBlock Text="Bas-Konuş veya Aç/Kapa modu"
                                       Foreground="{StaticResource BrushTextDim}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableTriggerModes}"
                                  SelectedItem="{Binding SelectedTriggerMode, Mode=TwoWay}" />
                    </Grid>

                    <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,4,0,16" />

                    <TextBlock Text="Yapay Zeka ve Dil"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Dikte Dili"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontWeight="Medium"
                                       FontSize="13" />
                            <TextBlock Text="Transkripsiyon hedef dili"
                                       Foreground="{StaticResource BrushTextDim}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Whisper Modeli"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontWeight="Medium"
                                       FontSize="13" />
                            <TextBlock Text="Hız ve doğruluk dengesi"
                                       Foreground="{StaticResource BrushTextDim}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}" />
                    </Grid>

                    <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,4,0,16" />

                    <TextBlock Text="Girdi ve Ses Aygıtı"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Metin Yazım Yöntemi"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontWeight="Medium"
                                       FontSize="13" />
                            <TextBlock Text="Pano Takası veya SendInput"
                                       Foreground="{StaticResource BrushTextDim}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableInjectionModes}"
                                  SelectedItem="{Binding SelectedInjectionMode, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Mikrofon Aygıtı"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontWeight="Medium"
                                       FontSize="13" />
                        </StackPanel>
                        <ComboBox Grid.Row="2"
                                  ItemsSource="{Binding AvailableAudioDevices}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource BrushBackgroundSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource ButtonGhost}"
                            Command="{Binding CancelCommand}"
                            Content="İptal"
                            Margin="0,0,12,0" />
                    <Button Style="{StaticResource ButtonPrimary}"
                            Command="{Binding SaveCommand}"
                            Content="Kaydet ve Uygula" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
